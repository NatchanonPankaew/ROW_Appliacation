{
  // Cloudflare Worker + Static Assets. The Worker (worker/index.js) runs first so
  // it can gate /data and /media (self-hosted dataset + images) to same-origin
  // requests only — deterring hotlinking/scraping. Everything else is served from
  // ./dist as a normal static SPA.
  "name": "row-appliacation",
  "compatibility_date": "2025-06-01",
  "main": "worker/index.js",
  // page-view counter store
  "kv_namespaces": [
    { "binding": "VIEWS", "id": "973ebd5b050e4b85b1063a10266bb34f" }
    // Add a second entry here for signed-in players' Maps progress once you've
    // run `npx wrangler kv namespace create MAPS_SYNC` — see
    // README-google-sync.md step 2. Deliberately NOT added yet: Cloudflare
    // validates that KV namespace ids exist at deploy time, so a placeholder
    // id here would fail every deploy (this whole site), not just this
    // feature. The /api/sync/maps route in worker/index.js already handles
    // the binding being absent by 401-ing before it'd ever touch it.
  ],
  // Google OAuth Web client id (from Google Cloud Console) — public value,
  // safe to commit once real. See README-google-sync.md step 3a. Sign-in
  // just always fails token verification (safe 401) while this is a
  // non-matching placeholder.
  "vars": {
    "GOOGLE_CLIENT_ID": "REPLACE_ME.apps.googleusercontent.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // run the Worker before serving assets (otherwise static files bypass it)
    "run_worker_first": true,
    // SPA: unknown routes fall back to index.html
    "not_found_handling": "single-page-application"
  }
}
